\n\n    // Step 4: For each remaining number in the list, update if greater.\n    for (size_t i = 1; i < numbers.size(); ++i) {\n        if (numbers[i] > largest) {\n            largest = numbers[i];\n        }\n    }\n\n    // Step 5: Display the largest number.\n    // Step 6: Stop\n    std::cout << largest << std::endl;\n\n    return 0;\n}\n","stdin":"","language":"c","level":3,"kind":"run","result":{"status":"success","stdout":"8\n","stderr":"","compilerOutput":"","diagnostics":[],"notes":[],"exitCode":0,"durationMs":4408,"engine":"wandbox","language":"c"}},"snapshot":{"title":"Input & output · success","createdAt":"2026-10-18T17:07:07.607Z"}}}
