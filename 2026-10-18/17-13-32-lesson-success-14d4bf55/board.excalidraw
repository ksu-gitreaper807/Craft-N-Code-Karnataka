,[\"zcJoAZi-yXpK21_423Uxp\",\"freedraw\",561,188.5,93,53,0,\"#1971c2\",2,[[0,0],[0,-0.5],[2,-1],[9.5,-3.5],[16.5,-4.5],[23,-4.5],[34,-4],[39.5,-2],[44,-1],[47.5,1.5],[50,3.5],[51.5,6],[52,7.5],[53.5,13.5],[54.5,17.5],[54,22],[52.5,25.5],[51,27.5],[48.5,32],[42,37],[31.5,44],[29,46],[27,47.5],[26.5,48],[26.5,48.5],[27,48.5],[29,48.5],[31.5,48.5],[34.5,48.5],[38.5,48.5],[44,48.5],[48,48.5],[64,48.5],[73.5,48.5],[81.5,48.5],[86.5,48.5],[91,48.5],[93,48.5],[93,48.5]],[],true,100,\"transparent\",null,null,null,null,null],[\"3NrexVahC9SGM1LEIIMj1\",\"freedraw\",696.5,178,80,57,0,\"#1971c2\",2,[[0,0],[0,-0.5],[0.5,-0.5],[3.5,-1.5],[9,-2],[14.5,-3],[22.5,-3],[25.5,-3],[36,-3],[43,-3],[46,-3],[51.5,-2],[55,0.5],[55.5,3],[56.5,5],[55.5,10.5],[53,12.5],[49.5,16.5],[46,19],[43.5,20.5],[40.5,22],[39,22.5],[39,23.5],[38.5,23.5],[38.5,23],[40,22.5],[42,22],[44.5,21],[47.5,20.5],[51.5,19.5],[56,19.5],[60,19.5],[65.5,20],[70,21.5],[76,26],[78,27.5],[79.5,29.5],[80,31.5],[80,34],[80,34.5],[80,36.5],[78.5,38],[74,41.5],[71,43.5],[66,46],[56.5,48],[51,50],[46.5,51],[37,52],[30,53],[15.5,54],[13,54],[11,54],[10.5,54],[10,54],[9.5,54],[9.5,53.5],[9.5,53.5]],[],true,100,\"transparent\",null,null,null,null,null]]]","codeFingerprint":"[\"9_JNTbNaFI5iI9MBmswoS\",[[\"jfq2owZKqjc2aTeEzf0CP\",\"freedraw\",641.5,367,0.0001,0.0001,0,\"#1e1e1e\",2,[[0,0],[0.0001,0.0001]],[],true,100,\"transparent\",null,null,null,null,null],[\"WwJvU4Yxs3-TNCNvsPppT\",\"text\",316,278,878.90625,192,0,\"#1e1e1e\",2,null,null,null,100,\"transparent\",\"1. Start\\n2. Look at a list of numbers.\\n3. Assume the first number is the largest.\\n4. For each remaining number in the list:\\n   If the current number is greater than your largest, update your largest.\\n5. Display the largest number.\\n6. Stop\\n\",20,3,1.2,null]]]","codeConfirmedAt":"2026-10-18T17:10:33.697Z","language":"c","program":{"source":"1. Start\n2. Look at a list of numbers.\n3. Assume the first number is the largest.\n4. For each remaining number in the list:\n   If the current number is greater than your largest, update your largest.\n5. Display the largest number.\n6. Stop","stdin":"1 2 3","lineMap":[null,null,null,null,null,null,null],"codeIds":[],"inputIds":[],"language":"c"},"raw":{"code":[],"stdin":[{"text":"1 2 3","box":null,"uncertain":false,"alternatives":[]}],"provider":"gemini","model":"gemini-3.5-flash-lite","durationMs":1787,"requiresConfirmation":true,"language":"c"},"reviewed":{"code":["1. Start","2. Look at a list of numbers.","3. Assume the first number is the largest.","4. For each remaining number in the list:","   If the current number is greater than your largest, update your largest.","5. Display the largest number.","6. Stop"],"stdin":["1 2 3"]},"confirmedAt":"2026-10-18T17:13:24.373Z"},"execution":{"source":"#include <iostream>\n#include <vector>\n#include <sstream>\n\nint main() {\n    // Step 1 & 2: Read list of numbers from stdin\n    std::string line;\n    if (!std::getline(std::cin, line)) {\n        return 0;\n    }\n    \n    std::stringstream ss(line);\n    std::vector<int> numbers;\n    int num;\n    while (ss >> num) {\n        numbers.push_back(num);\n    }\n\n    if (numbers.empty()) {\n        return 0;\n    }\n\n    // Step 3: Assume the first number is the largest.\n    int largest = numbers[0];\n\n    // Step 4: For each remaining number in the list:\n    // If the current number is greater than your largest, update your largest.\n    for (size_t i = 1; i < numbers.size(); ++i) {\n        if (numbers[i] > largest) {\n            largest = numbers[i];\n        }\n    }\n\n    // Step 5: Display the largest number.\n    std::cout << largest << std::endl;\n\n    // Step 6: Stop\n    return 0;\n}\n","stdin":"1 2 3","language":"c","level":3,"kind":"run","result":{"status":"success","stdout":"3\n","stderr":"","compilerOutput":"","diagnostics":[],"notes":[],"exitCode":0,"durationMs":4405,"engine":"wandbox","language":"c"}},"snapshot":{"title":"Lesson · success","createdAt":"2026-10-18T17:13:32.303Z"}}}
